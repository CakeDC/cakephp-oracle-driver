{
    "name": "cakedc/cakephp-oracle-driver",
    "description": "CakePHP 5 Driver for Oracle Database",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "oracle",
        "database",
        "driver"
    ],
    "homepage": "https://github.com/cakedc/cakephp-oracle-driver",
    "license": "MIT",
    "authors": [
        {
            "name": "CakeDC",
            "homepage": "http://www.cakedc.com",
            "role": "Author"
        },
        {
            "name": "Others",
            "homepage": "https://github.com/cakedc/cakephp-oracle-driver/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/cakedc/cakephp-oracle-driver/issues",
        "source": "https://github.com/cakedc/cakephp-oracle-driver"
    },
    "config": {
        "preferred-install": {
            "cakephp/cakephp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.3",
        "cakephp/chronos": "^3.3",
        "ext-intl": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.14",
        "cakedc/cakephp-phpstan": "^4.3",
        "cakephp/cakephp-codesniffer": "^5.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5 | ^12.0",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "CakeDC\\OracleDriver\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakeDC\\OracleDriver\\Test\\": "tests",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests",
            "Company\\TestPluginThree\\Test\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/Company/TestPluginThree/tests",
            "TestApp\\": "vendor/cakephp/cakephp/tests/test_app/TestApp",
            "TestPlugin\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/TestPlugin/src",
            "TestPlugin\\Test\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/TestPlugin/tests",
            "TestPluginTwo\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/TestPluginTwo/src",
            "PluginJs\\": "vendor/cakephp/cakephp/tests/test_app/Plugin/PluginJs/src"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "php tests/run-database-tests.php",
        "test:database": "vendor/bin/phpunit --testsuite=Database",
        "test:orm": "vendor/bin/phpunit --testsuite=ORM",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "vendor/bin/phpstan analyse src/",
        "stan-baseline": "vendor/bin/ analyse --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    }
}
